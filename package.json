{
  "name": "ct-scan-scheduling",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:server": "node --env-file=.env --watch --import tsx server/src/index.ts",
    "start:server:dist": "node --env-file=.env server/dist/server/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx --tsconfig tsconfig.server.json prisma/seed.ts",
    "build:e2e": "VITE_API_URL=http://127.0.0.1:3100/api VITE_SOCKET_URL=http://127.0.0.1:3100 npm run build",
    "e2e:db:reset": "node scripts/e2e-reset.mjs",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4174",
    "build": "npm run prisma:generate && tsc -b && vite build",
    "typecheck": "npm run prisma:generate && tsc -b",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=4",
    "test:a11y": "vitest run accessibility --maxWorkers=4",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "test:e2e": "npm run build:e2e && npm run e2e:db:reset && playwright test",
    "test:e2e:headed": "npm run build:e2e && npm run e2e:db:reset && playwright test --headed",
    "test:server": "node scripts/test-server.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.16.2",
    "@quixo3/prisma-session-store": "^3.1.21",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-virtual": "^3.14.5",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "i18next": "^26.3.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^17.0.8",
    "react-router-dom": "7.18.2",
    "recharts": "^2.13.3",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prisma": "^6.16.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "1.1.17",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
